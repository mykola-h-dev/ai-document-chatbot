# Copy to .env and fill in. Leave both keys empty to run in offline demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Alternatively use OpenAI (used only if GEMINI_API_KEY is empty):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Business details shown in answers
BUSINESS_NAME=Maple Street Dental
BUSINESS_CONTACT=call 555-0142 or email hello@maplestreetdental.example

# Where documents and logs live. SEED_DIR is copied into DATA_DIR/docs on the first start.
DATA_DIR=data
SEED_DIR=sample_docs

# Admin page password. Empty = admin page only reachable from this computer (127.0.0.1).
ADMIN_PASSWORD=

# Questions per visitor IP per minute, and allowed embedding sites (comma separated, * = any)
RATE_LIMIT_PER_MINUTE=20
ALLOWED_ORIGINS=*
# Set to 1 behind a reverse proxy so rate limits use X-Forwarded-For
TRUST_PROXY=0
# Offline mode "typing" speed in milliseconds per word (0 = instant)
STREAM_DELAY_MS=25

HOST=127.0.0.1
PORT=8000
